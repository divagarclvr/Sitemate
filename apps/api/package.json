{
  "name": "@sitemate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "try:chat": "tsx --env-file=.env src/scripts/try-chat.ts",
    "try:planner": "tsx --env-file=.env src/scripts/try-planner.ts",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "check:ai": "tsx --env-file=.env src/scripts/check-ai.ts",
    "try:audio": "tsx --env-file=.env src/scripts/try-audio.ts",
    "check:storage": "tsx --env-file=.env src/scripts/check-storage.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@google/genai": "^2.24.0",
    "@sitemate/shared": "^0.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "fastify": "^5.12.5",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^22.1.1",
    "groq-sdk": "^1.6.0",
    "heic-convert": "^2.1.0",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "node-ical": "^0.27.2",
    "officeparser": "^8.0.0",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^26.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^5.0.2"
  }
}
