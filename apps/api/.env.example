# Copy this file to ".env" (same folder) and fill in the values. NEVER share or commit .env.
# Every value below is free. See README.md → Phase 1 for where to find each one.

NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
TZ_DEFAULT=Asia/Kolkata

# ── Supabase (supabase.com → your project) ──
# Connect button → "Transaction pooler" → copy the URI and put your database password in it
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Leave empty (new Supabase projects use public signing keys, which the server fetches itself).
SUPABASE_JWT_SECRET=
# Only these emails may use your server (comma-separated)
ALLOWED_EMAILS=you@example.com

# ── AI (free) ──
AI_PROVIDER=gemini
# aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_MODEL_LITE=gemini-3.5-flash-lite,gemini-3.6-flash

# Backup AI + speech-to-text: console.groq.com → API Keys
AI_FALLBACK_PROVIDER=groq
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b

# ── Limits ──
RATE_LIMIT_PER_MIN=60
