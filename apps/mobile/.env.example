# Copy this file to ".env" (same folder). These values are PUBLIC and safe inside the app.
# NEVER put AI keys (Gemini, Groq) here — they live only on the server.

# Your server address. On your own Wi-Fi while testing: http://<your-PC-IP>:8080
# After deploying: https://sitemate-api.onrender.com (or whatever Render gives you)
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080

# Supabase → Project Settings → Data API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase → Project Settings → API Keys → "Publishable key" (starts with sb_publishable_)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
